# Compiled binaries and objects
rtest
test-generators
test-nonperiodic-boundary
a.out
*.o
*.a
tmp.out

# Per-run test outputs from the batch scripts.
# The suffixes are inconsistent upstream: rtest1m.sh writes .tst1m, the rest
# write .test<size>. Both spellings are listed on purpose.
*.tst1m
*.test10m
*.test100m
*.test1g
*.test10g
*.expansion

# but keep the sample outputs that ship with upstream rtest
!genone.bin.test10m
!genone.bin.test100m
!rtest100m.sh.test100m

# LaTeX build products (doc/) — note: the committed *.pdf in doc/pdfs are kept
*.aux
*.log
*.toc

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Output of scripts/reproduce_randomness_demo.py, if run inside the checkout
randomness-demo/
